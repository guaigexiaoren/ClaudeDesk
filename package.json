{
  "name": "claude-desk",
  "productName": "ClaudeDesk",
  "version": "1.0.0",
  "description": "ClaudeDesk - 基于 Claude Code 的桌面图形工作台",
  "main": "electron/main.js",
  "author": "YYMY",
  "license": "MIT",
  "scripts": {
    "build:renderer": "esbuild renderer/app.js --bundle --outfile=renderer/bundle.js --format=iife --platform=browser --target=chrome120 --log-level=warning",
    "prestart": "npm run build:renderer",
    "start": "electron .",
    "test": "node --test",
    "pack": "npm run build:renderer && electron-builder --dir",
    "dist": "npm run build:renderer && electron-builder --win portable",
    "dist:mac": "npm run build:renderer && electron-builder --mac dmg zip"
  },
  "build": {
    "appId": "com.yymy.claudedesk",
    "productName": "ClaudeDesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "build/**/*",
      "package.json",
      "node_modules/@anthropic-ai/**/*",
      "node_modules/@modelcontextprotocol/**/*",
      "node_modules/zod/**/*",
      "node_modules/marked/**/*",
      "node_modules/dompurify/**/*",
      "node_modules/highlight.js/**/*",
      "node_modules/diff/**/*"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "ClaudeDesk.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  }
}
